<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/settings_up"
            style="@style/SmallIconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_navigate_up"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/SettingsSection"
                android:text="@string/settings_search_engine" />

            <RadioGroup
                android:id="@+id/engine_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <EditText
                android:id="@+id/custom_template"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_custom_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:minHeight="48dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                tools:targetApi="o" />

            <TextView
                android:id="@+id/custom_help"
                style="@style/SettingsSummary"
                android:text="@string/settings_custom_help" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/settings_content" />

            <Switch
                android:id="@+id/safe_search_switch"
                style="@style/SettingsSwitch"
                android:text="@string/settings_safe_search" />

            <TextView
                style="@style/SettingsSummary"
                android:text="@string/settings_safe_search_summary" />

            <Switch
                android:id="@+id/javascript_switch"
                style="@style/SettingsSwitch"
                android:text="@string/settings_javascript" />

            <TextView
                style="@style/SettingsSummary"
                android:text="@string/settings_javascript_summary" />

            <Switch
                android:id="@+id/desktop_switch"
                style="@style/SettingsSwitch"
                android:text="@string/settings_desktop_site" />

            <TextView
                style="@style/SettingsSummary"
                android:text="@string/settings_desktop_site_summary" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/settings_privacy" />

            <TextView
                android:id="@+id/clear_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:text="@string/menu_clear_data"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                style="@style/SettingsSummary"
                android:text="@string/settings_clear_data_summary" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/settings_about" />

            <TextView
                android:id="@+id/about_text"
                style="@style/SettingsSummary"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
